generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  phoneNumber      String            @unique
  email            String?           @unique
  name             String?
  role             Role              @default(CUSTOMER)
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fcmToken         String?
  passwordHash     String?
  bookings         Booking[]
  receivedMessages ChatMessage[]     @relation("ReceivedMessages")
  sentMessages     ChatMessage[]     @relation("SentMessages")
  customers        Customer[]
  kycrecords       KYCRecord[]
  leaveRequests    LeaveRequest[]
  notifications    Notification[]
  managedProviders ServiceProvider[] @relation("TeamLeaderProviders")
  serviceProviders ServiceProvider[]
  wallets          Wallet[]
}

model ServiceCategory {
  id        String            @id @default(uuid())
  name      String
  icon      String
  active    Boolean           @default(true)
  items     ServiceItem[]
  providers ServiceProvider[] @relation("ServiceCategoryToServiceProvider")
}

model ServiceItem {
  id              String            @id @default(uuid())
  name            String
  description     String
  price           Decimal
  imageUrl        String?
  categoryId      String
  durationMinutes Int               @default(60)
  bookings        Booking[]
  category        ServiceCategory   @relation(fields: [categoryId], references: [id])
  providers       ServiceProvider[] @relation("ServiceItemToServiceProvider")
}

model Booking {
  id                 String             @id @default(uuid())
  userId             String
  serviceId          String
  providerId         String?
  status             BookingStatus      @default(PENDING)
  date               DateTime
  city               String?
  totalAmount        Decimal
  startOTP           String?
  jobStartedAt       DateTime?
  jobEndedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  addressId          String?
  bookingType        String             @default("Instant")
  durationMinutes    Int                @default(60)
  cancellationReason String?
  cancelledAt        DateTime?
  paymentStatus      String             @default("PENDING")
  couponId           String?
  discountAmount     Decimal?           @default(0)
  purchasedCouponId  String?
  coupon             Coupon?            @relation(fields: [couponId], references: [id])
  provider           ServiceProvider?   @relation(fields: [providerId], references: [id])
  purchasedCoupon    PurchasedCoupon?   @relation(fields: [purchasedCouponId], references: [id])
  service            ServiceItem        @relation(fields: [serviceId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  BookingExtension   BookingExtension[]
  bookingOverrides   BookingOverride[]
  payments           Payment[]
  spBookings         SpBooking[]
}

model Coupon {
  id                 String            @id @default(uuid())
  code               String            @unique
  discountPercent    Decimal
  maxDiscount        Decimal?
  expiryDate         DateTime
  isActive           Boolean           @default(true)
  usageLimit         Int               @default(0)
  usedCount          Int               @default(0)
  isVisibleOnHome    Boolean           @default(false)
  price              Decimal           @default(0)
  allowedJobsCount   Int               @default(0)
  jobDurationMinutes Int               @default(60)
  description        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  bookings           Booking[]
  purchasedCoupons   PurchasedCoupon[]
}

model PurchasedCoupon {
  id            String    @id @default(uuid())
  customerId    String
  couponId      String
  remainingJobs Int
  totalJobs     Int
  jobDuration   Int
  isPaid        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  coupon        Coupon    @relation(fields: [couponId], references: [id])
  customer      Customer  @relation(fields: [customerId], references: [id])
}

model PricingRule {
  id           String   @id @default(uuid())
  service_type String
  city         String
  base_price   Decimal
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SurgeRule {
  id            String  @id @default(uuid())
  PricingRuleid String
  multiplier    Decimal
  condition     Decimal
}

model AdminRole {
  id          String      @id @default(uuid())
  role_name   String
  permissions String[]    @default([])
  adminUsers  AdminUser[]
}

model AdminUser {
  id           String     @id @default(uuid())
  name         String?
  role_id      String
  email        String?    @unique
  phoneNumber  String?    @unique
  passwordHash String?
  adminRole    String     @default("SUPER_ADMIN")
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         AdminRole  @relation(fields: [role_id], references: [id])
  auditLogs    AuditLog[]
}

model AuditLog {
  id         String     @id @default(uuid())
  admin_id   String?
  action     String
  action_at  DateTime   @default(now())
  details    String?
  admin_user AdminUser? @relation(fields: [admin_id], references: [id])
}

model KYCRecord {
  id           String        @id @default(uuid())
  user_id      String
  status       String        @default("PENDING")
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kycdocuments KYCDocument[]
  user         User          @relation(fields: [user_id], references: [id])
}

model BookingOverride {
  id         String   @id @default(uuid())
  booking_id String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking  @relation(fields: [booking_id], references: [id])
}

model KYCDocument {
  id            String    @id @default(uuid())
  kyc_id        String
  document_type String
  file_url      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  kyc           KYCRecord @relation(fields: [kyc_id], references: [id])
}

model ServiceProvider {
  id                 String                       @id @default(uuid())
  user_id            String
  name               String
  phoneNumber        String
  city               String?
  yearsOfExperience  Int?                         @default(0)
  status             String                       @default("PENDING")
  rating             Int                          @default(0)
  Kyc_status         String                       @default("PENDING")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  teamLeaderId       String?
  availabilities     Availability[]
  bookings           Booking[]
  customerBookings   CustomerBooking[]
  escalations        Escalation[]
  fraudFlags         FraudFlag[]
  issuedInventory    IssuedInventory[]
  locationPings      LocationPing[]
  providerAddresses  ProviderAddress[]
  providerProfiles   ProviderProfile[]
  ratings            Rating[]
  teamLeader         User?                        @relation("TeamLeaderProviders", fields: [teamLeaderId], references: [id])
  user               User                         @relation(fields: [user_id], references: [id])
  spBookings         SpBooking[]
  spWallets          SpWallet[]
  violations         Violation[]
  performanceMetrics performancemetric[]
  attendances        provider_Attendance[]
  shiftAssignments   provider_Shift_Assignments[]
  categories         ServiceCategory[]            @relation("ServiceCategoryToServiceProvider")
  items              ServiceItem[]                @relation("ServiceItemToServiceProvider")
}

model ProviderProfile {
  id          String          @id @default(uuid())
  provider_id String
  services    String[]
  experiences String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model Availability {
  id               String          @id @default(uuid())
  provider_id      String
  is_online        Boolean         @default(true)
  last_seen        DateTime        @default(now())
  currentLatitude  Float?
  currentLongitude Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  provider         ServiceProvider @relation(fields: [provider_id], references: [id])
}

model SpBooking {
  id            String          @id @default(uuid())
  provider_id   String
  status        String          @default("PENDING")
  start_time    DateTime
  end_time      DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  booking_id    String?
  locationPings LocationPing[]
  ratings       Rating[]
  booking       Booking?        @relation(fields: [booking_id], references: [id])
  provider      ServiceProvider @relation(fields: [provider_id], references: [id])
}

model performancemetric {
  id          String          @id @default(uuid())
  provider_id String
  metric      String
  value       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model FraudFlag {
  id          String          @id @default(uuid())
  provider_id String
  reason      String
  severity    String          @default("LOW")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model Violation {
  id          String          @id @default(uuid())
  provider_id String
  rule        String
  action      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model LocationPing {
  id          String          @id @default(uuid())
  provider_id String
  booking_id  String
  latitude    Float
  longitude   Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  booking     SpBooking       @relation(fields: [booking_id], references: [id])
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model Rating {
  id          String          @id @default(uuid())
  provider_id String
  booking_id  String
  score       Int             @default(0)
  comment     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  booking     SpBooking       @relation(fields: [booking_id], references: [id])
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model SpWallet {
  id          String          @id @default(uuid())
  provider_id String
  balance     Decimal         @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  payouts     Payout[]
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model Payout {
  id          String   @id @default(uuid())
  spwallet_id String
  amount      Decimal
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  spwallet    SpWallet @relation(fields: [spwallet_id], references: [id])
}

model Wallet {
  id            String         @id @default(uuid())
  user_id       String
  balance       Decimal        @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [user_id], references: [id])
  walletLedgers WalletLedger[]
  settlements   settlement[]
}

model WalletLedger {
  id         String   @id @default(uuid())
  wallet_id  String
  entry_type String
  amount     Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wallet     Wallet   @relation(fields: [wallet_id], references: [id])
}

model settlement {
  id        String   @id @default(uuid())
  wallet_id String
  amount    Decimal
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet    Wallet   @relation(fields: [wallet_id], references: [id])
}

model Customer {
  id                 String              @id @default(uuid())
  user_id            String
  name               String
  phoneNumber        String              @unique
  status             String              @default("PENDING")
  trust_score        Int                 @default(0)
  isOnboarded        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  referralCode       String?             @unique
  referredById       String?
  authSessions       AuthSession[]
  conciergeSessions  ConciergeSession[]
  referredBy         Customer?           @relation("CustomerReferrals", fields: [referredById], references: [id])
  referredUsers      Customer[]          @relation("CustomerReferrals")
  user               User                @relation(fields: [user_id], references: [id])
  customerAddresses  CustomerAddress[]
  customerBookings   CustomerBooking[]
  customerProfiles   CustomerProfile[]
  customerViolations CustomerViolation[]
  customerWallets    CustomerWallet[]
  purchasedCoupons   PurchasedCoupon[]
  supportTickets     SupportTicket[]
}

model CustomerViolation {
  id          String   @id @default(uuid())
  customer_id String
  reason      String
  severity    String   @default("LOW")
  action      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customer_id], references: [id])
}

model CustomerProfile {
  id          String   @id @default(uuid())
  customer_id String
  email       String
  profile     String
  preferences String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customer_id], references: [id])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customer_id String
  address     String
  latitude    Float
  longitude   Float
  city        String
  state       String
  country     String
  zipcode     String
  label       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customer_id], references: [id])
}

model AuthSession {
  id          String   @id @default(uuid())
  customer_id String
  device_id   String
  device_type String
  lastlogin   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customer_id], references: [id])
}

model CustomerWallet {
  id                    String                 @id @default(uuid())
  customer_id           String
  balance               Decimal                @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customer              Customer               @relation(fields: [customer_id], references: [id])
  customerWalletLedgers CustomerWalletLedger[]
}

model CustomerWalletLedger {
  id                String         @id @default(uuid())
  CustomerWallet_id String
  amount            Decimal        @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  description       String?
  CustomerWallet    CustomerWallet @relation(fields: [CustomerWallet_id], references: [id])
}

model CustomerBooking {
  id             String          @id @default(uuid())
  customer_id    String
  provider_id    String
  status         String          @default("PENDING")
  scheduled_at   DateTime        @default(now())
  completed_at   DateTime?
  startOTP       String?
  jobStartedAt   DateTime?
  jobEndedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       Customer        @relation(fields: [customer_id], references: [id])
  provider       ServiceProvider @relation(fields: [provider_id], references: [id])
  escalations    Escalation[]
  payments       Payment[]
  supportTickets SupportTicket[]
  trackingEvents TrackingEvent[]
}

model TrackingEvent {
  id                 String          @id @default(uuid())
  customerbooking_id String
  latitude           Float
  longitude          Float
  timestamp          DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  customerbooking    CustomerBooking @relation(fields: [customerbooking_id], references: [id])
}

model Payment {
  id                 String           @id @default(uuid())
  customerbooking_id String?
  booking_id         String?
  amount             Decimal          @default(0)
  status             String           @default("PENDING")
  method             String           @default("COD")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  booking            Booking?         @relation(fields: [booking_id], references: [id])
  customerbooking    CustomerBooking? @relation(fields: [customerbooking_id], references: [id])
  refunds            Refund[]
}

model SupportTicket {
  id                 String          @id @default(uuid())
  customer_id        String
  customerbooking_id String
  status             String          @default("PENDING")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  customer           Customer        @relation(fields: [customer_id], references: [id])
  customerbooking    CustomerBooking @relation(fields: [customerbooking_id], references: [id])
}

model Refund {
  id         String   @id @default(uuid())
  payment_id String
  amount     Decimal  @default(0)
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  payment    Payment  @relation(fields: [payment_id], references: [id])
}

model ProviderAddress {
  id          String          @id @default(uuid())
  provider_id String
  address     String
  latitude    Float
  longitude   Float
  city        String
  state       String
  country     String
  zipcode     String
  label       String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model provider_Bonus_Rules {
  id             String  @id @default(uuid())
  Rule_Name      String  @unique
  Amount         Decimal @default(0)
  Condition_Type String
}

model provider_Penalty_Rules {
  id             String  @id @default(uuid())
  Rule_Name      String  @unique
  Amount         Decimal @default(0)
  Violation_Type String
}

model provider_Shift_Type {
  id                String                       @id @default(uuid())
  Shift_Name        String
  Duration_hours    Int                          @default(0)
  Daily_Salary      Decimal                      @default(0)
  Overtime_Rate     Int                          @default(0)
  attendancePercent Int                          @default(90)
  status            String                       @default("ACTIVE")
  targetJobs        Int                          @default(5)
  attendances       provider_Attendance[]
  shiftAssignments  provider_Shift_Assignments[]
}

model provider_Shift_Assignments {
  id              String              @id @default(uuid())
  provider_id     String
  shift_type_id   String
  assignment_date DateTime            @default(now())
  Status          String              @default("PENDING")
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  provider        ServiceProvider     @relation(fields: [provider_id], references: [id])
  shift_type      provider_Shift_Type @relation(fields: [shift_type_id], references: [id])
}

model provider_Attendance {
  id              String              @id @default(uuid())
  provider_id     String
  shift_type_id   String
  attendance_date DateTime            @default(now())
  in_time         DateTime
  out_time        DateTime?
  total_hours     Int                 @default(0)
  Status          String              @default("PENDING")
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  provider        ServiceProvider     @relation(fields: [provider_id], references: [id])
  shift_type      provider_Shift_Type @relation(fields: [shift_type_id], references: [id])
}

model provider_Salary_Ledger {
  id             String   @id @default(uuid())
  provider_id    String
  Shift_Date     DateTime @default(now())
  Base_Salary    Decimal  @default(0)
  Overtime_pay   Decimal  @default(0)
  Bonus_Amount   Decimal  @default(0)
  Penalty_Amount Decimal  @default(0)
  Total_pay      Decimal  @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model provider_payroll_settlement {
  id              String   @id @default(uuid())
  provider_id     String
  Payout_Cycle    DateTime @default(now())
  total_bonus     Decimal  @default(0)
  total_penalty   Decimal  @default(0)
  total_deduction Decimal  @default(0)
  total_payment   Decimal  @default(0)
  status          String   @default("PENDING")
  payout_date     DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model adminNotification {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String
  entityId  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id        String   @id @default(uuid())
  userId    String
  type      String
  fromDate  DateTime
  toDate    DateTime
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Escalation {
  id                 String           @id @default(uuid())
  provider_id        String
  customerbooking_id String?
  title              String
  description        String
  status             String           @default("OPEN")
  priority           String           @default("MEDIUM")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  customerbooking    CustomerBooking? @relation(fields: [customerbooking_id], references: [id])
  provider           ServiceProvider  @relation(fields: [provider_id], references: [id])
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   @default("GENERAL")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id                String            @id @default(uuid())
  name              String
  description       String?
  totalQuantity     Int               @default(0)
  availableQuantity Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  issuedItems       IssuedInventory[]
}

model IssuedInventory {
  id          String          @id @default(uuid())
  provider_id String
  item_id     String
  quantity    Int             @default(1)
  status      String          @default("ISSUED")
  issuedAt    DateTime        @default(now())
  returnedAt  DateTime?
  remarks     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  item        InventoryItem   @relation(fields: [item_id], references: [id])
  provider    ServiceProvider @relation(fields: [provider_id], references: [id])
}

model ConciergeSession {
  id         String              @id @default(uuid())
  customerId String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  auditLogs  ConciergeAuditLog[]
  messages   ConciergeMessage[]
  customer   Customer            @relation(fields: [customerId], references: [id])
}

model ConciergeMessage {
  id        String           @id @default(uuid())
  sessionId String
  sender    String
  text      String
  createdAt DateTime         @default(now())
  session   ConciergeSession @relation(fields: [sessionId], references: [id])
}

model ConciergeAuditLog {
  id         String           @id @default(uuid())
  sessionId  String
  actionType String
  details    String
  createdAt  DateTime         @default(now())
  session    ConciergeSession @relation(fields: [sessionId], references: [id])
}

model Banner {
  id           String   @id
  title        String
  subtitle     String?
  imageUrl     String
  redirectType String   @default("NONE")
  redirectId   String?
  startDate    DateTime @default(now())
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model BookingExtension {
  id                   String                 @id
  bookingId            String
  extraMinutes         Int
  additionalPrice      Decimal
  status               ExtensionStatus        @default(PENDING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  Booking              Booking                @relation(fields: [bookingId], references: [id])
  ExtensionAuditRecord ExtensionAuditRecord[]
}

model ExtensionAuditRecord {
  id               String            @id
  bookingId        String
  extensionId      String?
  action           String
  details          String
  createdAt        DateTime          @default(now())
  BookingExtension BookingExtension? @relation(fields: [extensionId], references: [id])
}

model HelpCard {
  id                 String   @id
  title              String
  description        String
  imageUrl           String
  orderIndex         Int      @default(0)
  isActive           Boolean  @default(true)
  coveredActivities  Json
  excludedActivities Json
  dos                String[]
  donts              String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  TEAM_LEADER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExtensionStatus {
  PENDING
  ACCEPTED
  REJECTED
}
