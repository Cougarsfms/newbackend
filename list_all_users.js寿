const { PrismaClient } = require('@prisma/client');

async function main() {
  const prisma = new PrismaClient();
  try {
    const users = await prisma.user.findMany({
        select: { id: true, phoneNumber: true, role: true, fcmToken: true }
    });
    console.log('--- All Users ---');
    users.forEach(u => {
        console.log(`Phone: ${u.phoneNumber}, Role: ${u.role}, FCM: ${u.fcmToken ? 'Yes' : 'No'}`);
    });
  } finally {
    await prisma.$disconnect();
  }
}

main();
